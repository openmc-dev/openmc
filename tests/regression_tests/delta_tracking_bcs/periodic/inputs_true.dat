<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="5" name="UO2" depletable="true">
      <density value="10.0" units="g/cm3"/>
      <nuclide name="U235" ao="1.0"/>
      <nuclide name="O16" ao="2.0"/>
    </material>
    <material id="6" name="light water">
      <density value="1.0" units="g/cm3"/>
      <nuclide name="H1" ao="2.0"/>
      <nuclide name="O16" ao="1.0"/>
      <sab name="c_H_in_H2O"/>
    </material>
  </materials>
  <geometry>
    <cell id="7" material="5" region="-11" universe="7"/>
    <cell id="8" material="6" region="11" universe="7"/>
    <cell id="9" fill="8" region="12 -13 14 -15" universe="9"/>
    <lattice id="8">
      <pitch>1.26 1.26</pitch>
      <dimension>2 2</dimension>
      <lower_left>-1.26 -1.26</lower_left>
      <universes>
7 7 
7 7 </universes>
    </lattice>
    <surface id="11" type="z-cylinder" coeffs="0.0 0.0 0.4"/>
    <surface id="12" name="minimum x" type="x-plane" boundary="periodic" coeffs="-1.26" periodic_surface_id="13"/>
    <surface id="13" name="maximum x" type="x-plane" boundary="periodic" coeffs="1.26" periodic_surface_id="12"/>
    <surface id="14" name="minimum y" type="y-plane" boundary="periodic" coeffs="-1.26" periodic_surface_id="15"/>
    <surface id="15" name="maximum y" type="y-plane" boundary="periodic" coeffs="1.26" periodic_surface_id="14"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>1000</particles>
    <batches>10</batches>
    <inactive>5</inactive>
    <photon_transport>false</photon_transport>
    <delta_tracking>true</delta_tracking>
  </settings>
  <tallies>
