  </materials>
  <geometry>
    <cell id="4" material="3" region="-6" universe="4"/>
    <cell id="5" material="4" region="6" universe="4"/>
    <cell id="6" fill="5" region="7 -8 9 -10" universe="6"/>
    <lattice id="5">
      <pitch>1.26 1.26</pitch>
      <dimension>2 2</dimension>
      <lower_left>-1.26 -1.26</lower_left>
      <universes>
4 4 
4 4 </universes>
    </lattice>
    <surface id="6" type="z-cylinder" coeffs="0.0 0.0 0.4"/>
    <surface id="7" name="minimum x" type="x-plane" boundary="reflective" coeffs="-1.26"/>
    <surface id="8" name="maximum x" type="x-plane" boundary="reflective" coeffs="1.26"/>
    <surface id="9" name="minimum y" type="y-plane" boundary="reflective" coeffs="-1.26"/>
    <surface id="10" name="maximum y" type="y-plane" boundary="reflective" coeffs="1.26"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>1000</particles>
    <batches>10</batches>
    <inactive>5</inactive>
