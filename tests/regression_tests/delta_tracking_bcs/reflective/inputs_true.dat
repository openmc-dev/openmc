      <nuclide name="O16" ao="2.0"/>
    </material>
    <material id="4" name="light water">
      <density value="1.0" units="g/cm3"/>
      <nuclide name="H1" ao="2.0"/>
      <nuclide name="O16" ao="1.0"/>
