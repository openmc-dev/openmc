<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>2g.h5</cross_sections>
    <material id="1" name="mat_1">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat_1"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="1 -2" universe="0"/>
    <surface id="1" type="x-plane" boundary="reflective" coeffs="0.0"/>
    <surface id="2" type="x-plane" boundary="vacuum" coeffs="929.45"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>1000</particles>
    <batches>10</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>0.0 -1000.0 -1000.0 929.45 1000.0 1000.0</parameters>
      </space>
    </source>
    <output>
      <summary>false</summary>
    </output>
    <energy_mode>multi-group</energy_mode>
    <tabular_legendre>
      <enable>false</enable>
    </tabular_legendre>
  </settings>
  <tallies>
    <filter id="2" type="energyout">
      <bins>0.0 0.625 20000000.0</bins>
    </filter>
    <filter id="3" type="delayedgroup">
      <bins>1 2</bins>
    </filter>
    <filter id="1" type="spatiallegendre">
      <order>1</order>
      <axis>x</axis>
      <min>-929.45</min>
      <max>929.45</max>
    </filter>
    <tally id="1" name="energyout-delayedgroup">
      <filters>2 3 1</filters>
      <scores>delayed-nu-fission</scores>
      <estimator>analog</estimator>
    </tally>
    <tally id="2" name="delayedgroup">
      <filters>3 1</filters>
      <scores>delayed-nu-fission</scores>
      <estimator>analog</estimator>
    </tally>
    <tally id="3" name="energyout">
      <filters>2 1</filters>
      <scores>delayed-nu-fission</scores>
      <estimator>analog</estimator>
    </tally>
  </tallies>
</model>
