<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>mgxs.h5</cross_sections>
    <material id="1">
      <density value="1.0" units="macro"/>
      <macroscopic name="photon"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-2 1 -4 3 -6 5" universe="1"/>
    <surface id="1" type="x-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="2" type="x-plane" boundary="reflective" coeffs="5.0"/>
    <surface id="3" type="y-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="4" type="y-plane" boundary="reflective" coeffs="5.0"/>
    <surface id="5" type="z-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="6" type="z-plane" boundary="reflective" coeffs="5.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>1000</particles>
    <batches>20</batches>
    <source type="independent" strength="1.0" particle="photon">
      <space type="box">
        <parameters>-5.0 -5.0 -5.0 5.0 5.0 5.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>1000000.0 1.0</parameters>
      </energy>
    </source>
    <energy_mode>multi-group</energy_mode>
    <photon_transport>true</photon_transport>
  </settings>
  <tallies>
    <filter id="1" type="energy">
      <bins>1000.0 100000.0 500000.0 2000000.0</bins>
    </filter>
    <filter id="2" type="particle">
      <bins>photon</bins>
    </filter>
    <tally id="1" name="photon">
      <filters>1 2</filters>
      <scores>flux total absorption scatter nu-scatter inverse-velocity</scores>
    </tally>
  </tallies>
</model>
