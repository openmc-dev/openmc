<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>2g.h5</cross_sections>
    <material id="1" name="legendre">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat_1"/>
    </material>
    <material id="2" name="tabular">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat_2"/>
    </material>
    <material id="3" name="histogram">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat_3"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="1 -2" universe="0"/>
    <cell id="2" material="2" region="2 -3" universe="0"/>
    <cell id="3" material="3" region="3 -4" universe="0"/>
    <surface id="1" type="x-plane" boundary="reflective" coeffs="0.0"/>
    <surface id="2" type="x-plane" coeffs="309.81666666666666"/>
    <surface id="3" type="x-plane" coeffs="619.6333333333333"/>
    <surface id="4" type="x-plane" boundary="vacuum" coeffs="929.45"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>100</particles>
    <batches>10</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>0.0 -1000.0 -1000.0 929.45 1000.0 1000.0</parameters>
      </space>
    </source>
    <output>
      <summary>false</summary>
    </output>
    <energy_mode>multi-group</energy_mode>
    <tabular_legendre>
      <enable>false</enable>
    </tabular_legendre>
  </settings>
  <tallies>
    <filter id="1" type="material">
      <bins>1 2 3</bins>
    </filter>
    <filter id="2" type="energy">
      <bins>0.0 0.625 20000000.0</bins>
    </filter>
    <tally id="1">
      <filters>1 2</filters>
      <scores>flux scatter nu-scatter</scores>
    </tally>
  </tallies>
</model>
