<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1">
      <density value="11.35" units="g/cm3"/>
      <nuclide name="Pb204" ao="0.014"/>
      <nuclide name="Pb206" ao="0.241"/>
      <nuclide name="Pb207" ao="0.221"/>
      <nuclide name="Pb208" ao="0.524"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <surface id="1" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 1.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>2000</particles>
    <batches>2</batches>
    <source type="independent" strength="1.0" particle="photon">
      <space type="point">
        <parameters>0.0 0.0 0.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>1000000.0 1.0</parameters>
      </energy>
    </source>
    <electron_treatment>ttb</electron_treatment>
    <atomic_relaxation>true</atomic_relaxation>
    <photon_transport>true</photon_transport>
    <cutoff>
      <energy_photon>1000.0</energy_photon>
    </cutoff>
  </settings>
  <tallies>
    <filter id="1" type="material">
      <bins>1</bins>
    </filter>
    <filter id="2" type="energy">
      <bins>1000.0 100000.0 500000.0 1100000.0</bins>
    </filter>
    <filter id="3" type="particle">
      <bins>photon</bins>
    </filter>
    <filter id="11" type="energyout">
      <bins>1000.0 100000.0 500000.0 1100000.0</bins>
    </filter>
    <filter id="12" type="particleproduction">
      <particles>photon</particles>
      <energies>1000.0 100000.0 500000.0 1100000.0</energies>
    </filter>
    <tally id="1">
      <filters>1 2 3</filters>
      <nuclides>total</nuclides>
      <scores>flux</scores>
      <estimator>tracklength</estimator>
    </tally>
    <tally id="2">
      <filters>1 2 3</filters>
      <nuclides>total</nuclides>
      <scores>total</scores>
      <estimator>tracklength</estimator>
    </tally>
    <tally id="3">
      <filters>1 2 3</filters>
      <nuclides>total</nuclides>
      <scores>flux</scores>
      <estimator>tracklength</estimator>
    </tally>
    <tally id="4">
      <filters>1 2 3</filters>
      <nuclides>total</nuclides>
      <scores>absorption</scores>
      <estimator>tracklength</estimator>
    </tally>
    <tally id="5">
      <filters>1 2 3</filters>
      <nuclides>total</nuclides>
      <scores>flux</scores>
      <estimator>tracklength</estimator>
    </tally>
    <tally id="6">
      <filters>1 2 11 3</filters>
      <nuclides>total</nuclides>
      <scores>scatter</scores>
      <estimator>analog</estimator>
    </tally>
    <tally id="7">
      <filters>1 2 12 3</filters>
      <nuclides>total</nuclides>
      <scores>events</scores>
      <estimator>analog</estimator>
    </tally>
  </tallies>
</model>
