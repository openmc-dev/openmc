<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1">
      <density value="1.0" units="g/cm3"/>
      <nuclide name="Zr90" ao="1.0"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <surface id="1" type="sphere" boundary="reflective" coeffs="0.0 0.0 0.0 100.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>100</particles>
    <batches>10</batches>
    <source type="independent" strength="1.0" particle="photon">
      <energy type="discrete">
        <parameters>1000000.0 1.0</parameters>
      </energy>
    </source>
    <electron_treatment>ttb</electron_treatment>
    <cutoff>
      <energy_photon>250000.0</energy_photon>
    </cutoff>
    <shared_secondary_bank>true</shared_secondary_bank>
  </settings>
  <tallies>
    <filter id="1" type="energy">
      <bins>0.0 250000.0 1000000.0</bins>
    </filter>
    <filter id="2" type="particle">
      <bins>photon</bins>
    </filter>
    <filter id="3" type="cell">
      <bins>1</bins>
    </filter>
    <filter id="4" type="energy">
      <bins>0.0 999999.0 1000001.0</bins>
    </filter>
    <filter id="5" type="energyout">
      <bins>0.0 1.0 250000.0 1000000.0</bins>
    </filter>
    <tally id="1" name="flux">
      <filters>1 2</filters>
      <scores>flux</scores>
    </tally>
    <tally id="2" name="heating">
      <nuclides>total Zr90</nuclides>
      <scores>heating</scores>
    </tally>
    <tally id="3" name="pulse-height">
      <filters>3 4</filters>
      <scores>pulse-height</scores>
    </tally>
    <tally id="4" name="outgoing">
      <filters>5 2</filters>
      <scores>events</scores>
      <estimator>analog</estimator>
    </tally>
  </tallies>
</model>
