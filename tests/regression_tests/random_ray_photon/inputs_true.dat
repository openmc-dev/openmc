<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>mgxs.h5</cross_sections>
    <material id="1">
      <density value="1.0" units="macro"/>
      <macroscopic name="photon"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-2 1 -4 3 -6 5" universe="1"/>
    <surface id="1" type="x-plane" boundary="vacuum" coeffs="-5.0"/>
    <surface id="2" type="x-plane" boundary="vacuum" coeffs="5.0"/>
    <surface id="3" type="y-plane" boundary="vacuum" coeffs="-5.0"/>
    <surface id="4" type="y-plane" boundary="vacuum" coeffs="5.0"/>
    <surface id="5" type="z-plane" boundary="vacuum" coeffs="-5.0"/>
    <surface id="6" type="z-plane" boundary="vacuum" coeffs="5.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>200</particles>
    <batches>10</batches>
    <inactive>3</inactive>
    <source type="independent" strength="1.0" particle="photon">
      <space type="point">
        <parameters>-2.5 0.0 0.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>1000000.0 1.0</parameters>
      </energy>
    </source>
    <energy_mode>multi-group</energy_mode>
    <photon_transport>true</photon_transport>
    <random_ray>
      <distance_inactive>50.0</distance_inactive>
      <distance_active>200.0</distance_active>
      <ray_source>
        <source type="independent" strength="1.0" particle="photon">
          <space type="box">
            <parameters>-5.0 -5.0 -5.0 5.0 5.0 5.0</parameters>
          </space>
        </source>
      </ray_source>
      <source_region_meshes>
        <mesh id="1">
          <domain id="1" type="universe"/>
        </mesh>
      </source_region_meshes>
    </random_ray>
    <mesh id="1">
      <dimension>2 1 1</dimension>
      <lower_left>-5.0 -5.0 -5.0</lower_left>
      <upper_right>5.0 5.0 5.0</upper_right>
    </mesh>
  </settings>
  <tallies>
    <filter id="1" type="mesh">
      <bins>1</bins>
    </filter>
    <filter id="2" type="energy">
      <bins>1000.0 100000.0 2000000.0</bins>
    </filter>
    <filter id="3" type="particle">
      <bins>photon</bins>
    </filter>
    <tally id="1">
      <filters>1 2 3</filters>
      <scores>flux total</scores>
    </tally>
  </tallies>
</model>
