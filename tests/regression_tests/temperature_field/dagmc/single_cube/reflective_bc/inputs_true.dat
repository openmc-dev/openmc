<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1" name="fuel" depletable="true">
      <density value="5.0" units="g/cm3"/>
      <nuclide name="U235" ao="0.2"/>
      <nuclide name="U238" ao="0.8"/>
      <nuclide name="O16" ao="1.999242"/>
      <nuclide name="O17" ao="0.000758"/>
      <nuclide name="H1" ao="3.99937704"/>
      <nuclide name="H2" ao="0.00062296"/>
      <sab name="c_H_in_H2O"/>
    </material>
  </materials>
  <geometry>
    <dagmc_universe id="1" auto_geom_ids="true" filename="single_cube_cell_reflecting.h5m"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>200</particles>
    <batches>20</batches>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>0.0 0.0 0.0 5.0 5.0 5.0</parameters>
      </space>
      <constraints>
        <fissionable>true</fissionable>
      </constraints>
    </source>
    <temperature_field>
      <mesh>1</mesh>
      <values>294.0 394.0 494.0 594.0 694.0 794.0 894.0 994.0</values>
    </temperature_field>
    <mesh id="1">
      <dimension>2 2 2</dimension>
      <lower_left>0.0 0.0 0.0</lower_left>
      <upper_right>5.0 5.0 5.0</upper_right>
    </mesh>
    <temperature_multipole>true</temperature_multipole>
    <temperature_tolerance>1000</temperature_tolerance>
  </settings>
  <tallies>
    <filter id="1" type="mesh">
      <bins>1</bins>
    </filter>
    <tally id="1" name="total reaction rate">
      <filters>1</filters>
      <scores>total</scores>
    </tally>
  </tallies>
</model>
