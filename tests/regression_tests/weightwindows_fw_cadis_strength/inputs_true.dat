<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>mgxs.h5</cross_sections>
    <material id="1">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="1 -2" universe="1"/>
    <cell id="2" material="1" region="-1" universe="1"/>
    <cell id="3" material="1" region="2 -4 3 -6 5 -8 7" universe="1"/>
    <surface id="1" type="sphere" coeffs="0.0 0.0 0.0 3.098"/>
    <surface id="2" type="sphere" coeffs="0.0 0.0 0.0 3.1"/>
    <surface id="3" type="x-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="4" type="x-plane" boundary="reflective" coeffs="5.0"/>
    <surface id="5" type="y-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="6" type="y-plane" boundary="reflective" coeffs="5.0"/>
    <surface id="7" type="z-plane" boundary="reflective" coeffs="-5.0"/>
    <surface id="8" type="z-plane" boundary="reflective" coeffs="5.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>50</particles>
    <batches>10</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1e+18" particle="neutron">
      <space type="box">
        <parameters>-5.0 -5.0 -5.0 5.0 5.0 5.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>1000000.0 1.0</parameters>
      </energy>
      <constraints>
        <domain_type>cell</domain_type>
        <domain_ids>1</domain_ids>
      </constraints>
    </source>
    <energy_mode>multi-group</energy_mode>
    <weight_window_generators>
      <weight_windows_generator>
        <mesh>1</mesh>
        <particle_type>neutron</particle_type>
        <max_realizations>10</max_realizations>
        <update_interval>1</update_interval>
        <on_the_fly>true</on_the_fly>
        <method>fw_cadis</method>
      </weight_windows_generator>
    </weight_window_generators>
    <mesh id="1">
      <dimension>8 8 8</dimension>
      <lower_left>-5.0 -5.0 -5.0</lower_left>
      <upper_right>5.0 5.0 5.0</upper_right>
    </mesh>
    <random_ray>
      <distance_active>30.0</distance_active>
      <distance_inactive>30.0</distance_inactive>
      <ray_source>
        <source type="independent" strength="1.0" particle="neutron">
          <space type="box">
            <parameters>-5.0 -5.0 -5.0 5.0 5.0 5.0</parameters>
          </space>
        </source>
      </ray_source>
      <source_region_meshes>
        <mesh id="1">
          <domain id="1" type="cell"/>
          <domain id="2" type="cell"/>
          <domain id="3" type="cell"/>
        </mesh>
      </source_region_meshes>
    </random_ray>
  </settings>
  </model>
